{
  "name": "pharmacare-fullstack",
  "version": "1.0.0",
  "description": "Full-Stack Pharmacy Inventory Management System (React Frontend + Express.js Backend + MongoDB / PostgreSQL Database)",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "build": "npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "seed:reset": "node backend/src/scripts/seed.js --reset"
  },
  "keywords": [
    "pharmacy-inventory",
    "react",
    "express",
    "mongodb",
    "mongoose",
    "postgresql",
    "sequelize",
    "fullstack",
    "vite",
    "render",
    "vercel"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
