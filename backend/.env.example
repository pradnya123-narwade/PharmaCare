# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection
# For local development:
# MONGODB_URI=mongodb://127.0.0.1:27017/pharmacare_db
# For production (Render / MongoDB Atlas):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pharmacare_db?retryWrites=true&w=majority

# CORS Configuration
# Set this to your production frontend URL (e.g. on Vercel)
CLIENT_URL=https://your-pharmacare-frontend.vercel.app
